# Copiar este archivo a ".env" y completar con tus propios valores.
# NUNCA subir el archivo ".env" real al repositorio.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./codesentinel.db

# Proveedor de IA: gemini | groq
AI_PROVIDER=gemini
AI_API_KEY=coloca-aqui-tu-api-key

SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
